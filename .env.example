# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: required for cloud sync, tenant registration,
# and login. Get both from Supabase dashboard > Project Settings > API. Use the
# "service_role" secret key here (NOT the "anon"/"public" key) — this is only ever read
# server-side and must never be committed or shipped to a browser build.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# SUPER_ADMIN_PIN: optional support backdoor that bypasses any cashier's terminal PIN.
# Off by default (no fallback) — only set this if you deliberately want it, and keep it secret.
# SUPER_ADMIN_PIN="choose-a-strong-value"

# SESSION_SECRET: signs the login session cookie. Optional — if unset, one is generated
# automatically on first run and cached in the app-data folder (secrets.json), so ordinary
# installs need no configuration. Set this explicitly only for a self-hosted deployment where
# you want a known, portable secret (e.g. shared across multiple server instances).
# SESSION_SECRET="choose-a-strong-random-value"

# DEFAULT_ADMIN_PASSWORD: password for the local offline demo/seed tenant used only by
# establishLogin's offline fallback — a real customer's account comes from the cloud
# registration flow instead. Optional — if unset, a random password is generated the one time
# this seed tenant is created (it's hashed into the database immediately, not stored anywhere
# in plaintext). Only set this if you deliberately need a known password for that seed login.
# DEFAULT_ADMIN_PASSWORD="choose-a-strong-value"
